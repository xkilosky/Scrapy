# Scrapy's settings. Every one of them is optional.
# NONE OF THESE IS A KEY. Scrapy needs no account and no key anywhere.

# On Vercel, Scrapy's public address stays closed until this is set to 1.
# Test addresses (which need your Vercel login) and your own machine are always open.
SCRAPY_OPEN=0

# How pages get loaded: safe | middle | full
#   safe    Scrapy only asks the free helper services. It never downloads a page itself. (default)
#   middle  Helpers first. Scrapy downloads a page itself only when they are busy.
#   full    Scrapy downloads pages itself first. Helpers only for pages that need a real browser.
# Read "The three positions" in README.md before changing this on Vercel.
SCRAPY_MODE=safe

# The order in which the helpers are tried.
SCRAPY_SEARCH_ORDER=tavily,exa,parallel,firecrawl
SCRAPY_PAGE_ORDER=jina,firecrawl,tavily,parallel,exa

# Helpers that are never used, for example: SCRAPY_OFF=jina,exa
SCRAPY_OFF=

# The two brakes: calls a minute for each visitor, and calls a day for everybody together.
SCRAPY_VISITOR_PER_MINUTE=30
SCRAPY_DAILY_CALLS=1500

# Set to "off" to keep Scrapy's short memory inside each server instead of in Vercel's shared cache.
SCRAPY_SHARED_CACHE=on

# The log of tool calls behind the "Live feed". It holds what was asked and what was answered,
# and everybody who can open Scrapy's page can read it.
# Leave empty: on where that page is private (your own machine, Vercel's test addresses), off on Vercel's public address.
# "off": nothing is written down anywhere. "on": also on the public address. Only for an address strangers cannot open.
SCRAPY_LOGS=

# Set to 1 to check every free helper during a Vercel build. The result is written to the build log.
# Set to "memory" to try only Vercel's shared memory, which carries the log of tool calls.
SCRAPY_BUILD_PROBE=0
