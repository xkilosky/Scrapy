# Scrapy's settings. Every one of them is optional.
# None of these is a key or an account at another service: Scrapy needs none.
# One is a secret of your own, the password. Keep it out of files you share: set it in Vercel
# (Settings, Environment Variables), or in a file named .env.local on your own machine.

# The owner's password. With it, Scrapy is personal: it answers only to you.
#   - /login asks for it, and the dashboard and the live feed are for the browser that has logged in.
#   - Your AI sends a key that is made from it. The key is shown on the dashboard.
# At least 10 characters: several unrelated words, or a long random text. A shorter one lets nobody in.
# A new one logs every browser out and makes a new key.
# Without a password there are no logins: Scrapy is then open or closed, see SCRAPY_OPEN.
SCRAPY_PASSWORD=

# Only without a password. On Vercel, Scrapy's public address then stays closed until this is set to 1.
# Test addresses (which need your Vercel login) and your own machine are open without it.
SCRAPY_OPEN=0

# Set to 1 only for a copy of Scrapy that is shown inside a frame on another site's page, as some
# preview tools do. A browser keeps an ordinary login cookie out of such a frame. Ignored on Vercel.
SCRAPY_FRAMED=0

# How pages get loaded: safe | middle | full
#   safe    Scrapy only asks the free helper services. It never downloads a page itself. (default)
#   middle  Helpers first. Scrapy downloads a page itself only when they are busy.
#   full    Scrapy downloads pages itself first. Helpers only for pages that need a real browser.
# Read "The three positions" in README.md before changing this on Vercel.
SCRAPY_MODE=safe

# The order in which the helpers are tried.
SCRAPY_SEARCH_ORDER=tavily,exa,parallel,firecrawl
SCRAPY_PAGE_ORDER=jina,firecrawl,tavily,parallel,exa

# Helpers that are never used, for example: SCRAPY_OFF=jina,exa
SCRAPY_OFF=

# The two brakes: calls a minute for each caller, and calls a day for everybody together.
SCRAPY_VISITOR_PER_MINUTE=30
SCRAPY_DAILY_CALLS=1500

# Set to "off" to keep Scrapy's short memory inside each server instead of in Vercel's shared cache.
SCRAPY_SHARED_CACHE=on

# The log of tool calls behind the "Live feed". It holds what was asked and what was answered,
# and everybody who can open the dashboard can read it.
# Leave empty: on where the dashboard is private (with a password, on your own machine, on Vercel's test addresses),
# off on Vercel's public address without a password.
# "off": nothing is written down anywhere. "on": on everywhere. Only for an address strangers cannot open.
SCRAPY_LOGS=

# Set to 1 to check every free helper during a Vercel build. The result is written to the build log.
# Set to "memory" to try only Vercel's shared memory, which carries the log of tool calls.
SCRAPY_BUILD_PROBE=0
